{
  "name": "robinet-web",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/verifier-donnees.mjs && node scripts/generate-sitemap.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "postbuild": "node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "deploy": "npm run build && gh-pages -d dist -t -r https://github.com/aurelien032-glitch/meteo-du-robinet.git",
    "test": "vitest run",
    "scenes:export": "node scripts/export-scenes.mjs",
    "review": "node scripts/review-pages.mjs"
  },
  "dependencies": {
    "echarts": "^6.0.0",
    "maplibre-gl": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.13.0",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
